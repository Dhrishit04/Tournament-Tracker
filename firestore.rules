
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----

    // True if the caller is signed in with the `system_admin` role claim.
    function isSystemAdmin() {
      return request.auth != null
        && request.auth.token.role == 'system_admin';
    }

    // True if the caller is signed in as either system admin or a regular
    // admin (any value of `canAccessSettings`).
    function isAnyAdmin() {
      return request.auth != null
        && (request.auth.token.role == 'system_admin'
            || request.auth.token.role == 'admin');
    }

    // True if the caller can reach settings (i.e. a regular admin with the
    // elevation claim, or the system admin).
    function canAccessSettings() {
      return request.auth != null
        && (request.auth.token.role == 'system_admin'
            || (request.auth.token.role == 'admin'
                && request.auth.token.canAccessSettings == true));
    }

    // ---- /seasons/** (tournament data) ----
    // Reads stay public so the public site can render standings/teams/etc.
    // Writes require any signed-in admin.
    match /seasons/{seasonId}/{document=**} {
      allow read: if true;
      allow create, update, delete: if isAnyAdmin();
    }

    // ---- /config/app (season config, announcements, slideshow, feature flags) ----
    // Only the system admin can write. Settings-access admins are read-only
    // here (they don't need to flip flags, just see them).
    match /config/app {
      allow read: if true;
      allow create, update, delete: if isSystemAdmin();
    }

    // ---- /admins (staff metadata) ----
    // Readable by any signed-in admin so the config page can list staff.
    // Writable only by the system admin (and only via the manageAdmin
    // Cloud Function in practice — the client UI no longer writes here).
    match /admins/{adminId} {
      allow read: if isAnyAdmin();
      allow write: if isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    // ---- /logs (audit trail) ----
    // Only authed admins can create. The create rule forces `adminEmail`
    // to match the caller's token, blocking forged entries.
    // Only the system admin can read (the logs page is system-admin-only).
    match /logs/{logId} {
      allow create: if isAnyAdmin()
        && request.resource.data.adminEmail == request.auth.token.email;
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    // ---- /analytics/** (footfall counters) ----
    // Public read for the settings dashboard, public write so visitors can
    // register their visit via the tracker. This is the one path that
    // intentionally remains open on the write side.
    match /analytics/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSystemAdmin();
    }

    // ---- catch-all ----
    // Deny anything not matched above. Do NOT add a permissive catch-all
    // here — it would defeat the point of the rules above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
